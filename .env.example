# Optional: copy to .env to override built-in Docker Compose defaults
# Local defaults below must be replaced with real credentials on a server

# Application port on the local host
APP_PORT=19500

# Database (shared by local and production services)
DB_PORT=15432
DB_NAME=surok
DB_USERNAME=surok
DB_PASSWORD=local-development

# Yandex OAuth: placeholders allow local password login only
YA_ID=local-development
YA_SECRET=local-development

# Application and first administrator
APP_BASE_URL=https://surok.ru
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=LocalDevPass1!
APP_SECURITY_ALLOWED_ORIGINS=
APP_SECURITY_DOCS_ENABLED=false
APP_SECURITY_PROMETHEUS_ENABLED=false
APP_SECURITY_SECURE_COOKIE=false

# Production monitoring: set real credentials on the server
GF_SECURITY_ADMIN_PASSWORD=
MONITORING_BASIC_AUTH_USERNAME=
MONITORING_BASIC_AUTH_PASSWORD=
